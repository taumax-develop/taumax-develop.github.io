---
import { SITE_TITLE, BASE_URL } from '../consts';
import { TWITTER_CARD_SUMMARY } from '../components/BaseHead.astro';
import { indexPagebc } from './index.astro';
import SiteLayout, { type Breadcrumb } from '../layouts/SiteLayout.astro';
import type { index_pcsp } from '../components/Header.astro';

export const whoAreYouPagebc: Breadcrumb = {
  name: "自己紹介",
  item: `${BASE_URL}/who_are_you`
};
export const indexPagebcList: Breadcrumb[] = [indexPagebc, whoAreYouPagebc];

const indexList: index_pcsp[] = [];
